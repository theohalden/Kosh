[Unit]
Description=Pull and deploy the latest Tinward website image
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/web-hosting/updater/tinward-update
TimeoutStartSec=300
Nice=10
Environment=HOME=/var/lib/tinward-updater
StateDirectory=tinward-updater
# Needs the Docker socket (root-equivalent), so keep everything else locked down.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/web-hosting/sites/tinward /run
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
