# ── Public ────────────────────────────────────────────────────────────────
# Canonical site URL (used for links in emails, Open Graph and CORS-style origin checks).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Storage (server only – NEVER prefix with NEXT_PUBLIC_) ────────────────
# "supabase" in production. "memory" is a development/test driver and is refused when NODE_ENV=production.
WAITLIST_DRIVER=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email via Resend (server only) ─────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. "Kosh <hello@your-domain.in>"
EMAIL_FROM=
# Where the invitation email sends people. Set when a validated beta exists (Play testing link etc.).
INVITE_URL=

# ── Secrets (generate each with: openssl rand -hex 32) ─────────────────────
# Signs unsubscribe / deletion links and salts IP hashes.
TOKEN_SECRET=
# Bearer token for /api/admin/*. Leave empty to disable the admin endpoints entirely.
ADMIN_API_TOKEN=
